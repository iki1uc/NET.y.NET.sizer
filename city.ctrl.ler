// new.city.js — alle Karten neu gemischt — nur Leben, kein Unleben
import { atem } from './atem.js'
import { atom } from './atom.js'
import { ether } from './ether.js'
import { bioTel } from './bio.tel.js'
import { ram } from './ram.js'

export const newCity = {
  name: "NET.y.NET.sizer — new.city",
  karten: ["ATEM","ATOM","ETHER","LUNGE PFLANZE","LUNGE MENSCH","QI","RAM","VOID PAUSE","SCSI RAID","ZUG ATEM","MOOR MEHR"],
  gemischt: () => {
    // alle Karten mischen — Fisher-Yates — minimal
    let k = [...newCity.karten]
    for(let i=k.length-1;i>0;i--){ let j=Math.floor(Math.random()*(i+1)); [k[i],k[j]]=[k[j],k[i]] }
    return k
  },
  atmet: () => {
    // Stadt atmet 16s wie Lunge
    return atem.phase // EIN HALTEN AUS HALTEN2
  },
  lebt: () => {
    return atom.lebt && ram.da && ether.sum===100 && bioTel.kreislauf()
  },
  // new.city atmet CO2→O2→CO2→QI bleibt
  kreislauf: "CO2 (Zug) → O2 (Moor mehr) → CO2 (Stadt) → QI bleibt in new.city.js"
}
