// city.ctrl.ler = new.city.js — alle Karten neu gemischt — nur Leben
name: "NET.y.NET.sizer — new.city"
karten: ["ATEM","ATOM","ETHER","LUNGE PFLANZE","LUNGE MENSCH","QI","RAM","VOID PAUSE","SCSI RAID","ZUG ATEM","MOOR MEHR"]
gemischt() => Fisher-Yates
atmet() => atem.phase EIN/HALTEN/AUS/HALTEN2
lebt() => atom.lebt && ram.da && ether.sum===100 && bioTel.kreislauf()
kreislauf: "CO2 (Zug) → O2 (Moor mehr) → CO2 (Stadt) → QI bleibt"
